@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
}

<h1 class="mb-4">My results</h1>

@if (Model.Count == 0)
{
    <div class="empty-state panel">
        <div class="big">🏅</div>
        <h2 class="h4">No results yet</h2>
        <p>Your finish times and positions appear here once an organiser publishes the results of events you entered.</p>
        <a asp-controller="Participant" asp-action="Enrolments" class="btn btn-raceday">View my enrolments</a>
    </div>
}
else
{
    <p class="text-muted">@Model.Count completed @(Model.Count == 1 ? "event" : "events"), newest first.</p>
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-md-6">
                <div class="card result-card h-100">
                    <div class="card-body">
                        <h2 class="h4 mb-1">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId" class="text-decoration-none text-reset">@r.EventName</a>
                        </h2>
                        <p class="event-meta mb-3">📅 @UiHelpers.FormatDate(r.EventDate) &nbsp;|&nbsp; 🏷️ @r.CategoryName</p>
                        <div class="row">
                            <div class="col-5">
                                <div class="stat-label">Finish time</div>
                                <div class="result-time">@(r.FinishTime ?? "-")</div>
                            </div>
                            <div class="col-7">
                                <div class="stat-label">Position</div>
                                <div class="result-position">@UiHelpers.PositionText(r.FinishPosition, r.TotalFinishers)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
