@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}

<h1 class="mb-4">My enrolments</h1>

@if (Model.Count == 0)
{
    <div class="empty-state panel">
        <div class="big">🎽</div>
        <h2 class="h4">You haven't entered any events yet</h2>
        <p>Find an event you like and pick your category to enter.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-raceday">Browse events</a>
    </div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-raceday table-hover">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th>Entered on</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold text-decoration-none">@e.EventName</a></td>
                            <td>@UiHelpers.FormatDate(e.EventDate)</td>
                            <td>@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.EnrolmentStatus" /></td>
                            <td>@UiHelpers.ShortDate(e.EnrolmentDate)</td>
                            <td class="text-end">
                                @if (e.EventDate >= DateTime.UtcNow)
                                {
                                    <form asp-action="CancelEnrolment" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                          onsubmit="return confirm('Withdraw your entry for this event?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
