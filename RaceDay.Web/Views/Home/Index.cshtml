@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var loggedIn = Context.Session.IsLoggedIn();
}

<section class="hero mb-4">
    <h1>Find your next <span class="highlight">start line</span></h1>
    <p class="mb-3">Browse upcoming runs, walks and cycle races across South Africa, pick your category and enter in a few taps.</p>
    @if (!loggedIn)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-lime me-2">Create a free account</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Log in</a>
    }
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="q" class="form-label">Search</label>
            <input id="q" name="q" value="@Model.Q" class="form-control" placeholder="Event name or town" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Type))">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="distance" class="form-label">Distance</label>
            <select id="distance" name="distance" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Distance))">Any distance</option>
                <option value="short" selected="@(Model.Distance == "short")">Up to 10 km</option>
                <option value="medium" selected="@(Model.Distance == "medium")">10 to 25 km</option>
                <option value="long" selected="@(Model.Distance == "long")">25 to 50 km</option>
                <option value="ultra" selected="@(Model.Distance == "ultra")">Over 50 km</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-raceday flex-grow-1">Filter</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-raceday" title="Clear filters">Clear</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="empty-state panel">
        <div class="big">🏃</div>
        <h2 class="h4">No events match right now</h2>
        <p>Try clearing the filters, or check back soon. New events are added all the time.</p>
    </div>
}
else
{
    <p class="text-muted">@Model.Events.Count upcoming @(Model.Events.Count == 1 ? "event" : "events")</p>
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
