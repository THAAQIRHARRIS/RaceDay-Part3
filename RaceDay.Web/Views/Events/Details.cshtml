@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var role = Context.Session.GetRole();
    var categories = ev.Categories ?? new List<CategoryDto>();
}

<a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; All events</a>

<div class="mt-3 mb-4">
    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
    {
        <img src="@ev.BannerImageUrl" class="detail-banner" alt="Banner for @ev.Name" />
    }
    else
    {
        <div class="detail-banner detail-banner-placeholder" aria-hidden="true">@UiHelpers.TypeIcon(ev.EventType)</div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <span class="type-pill type-@ev.EventType.ToLowerInvariant()">@ev.EventType</span>
            <h1 class="display-title mb-3">@ev.Name</h1>
            <div class="row mb-3">
                <div class="col-sm-6 mb-2"><strong>📅 When</strong><br />@UiHelpers.FormatDateTime(ev.EventDate)</div>
                <div class="col-sm-6 mb-2"><strong>📍 Where</strong><br />@ev.Location</div>
                <div class="col-sm-6 mb-2"><strong>📏 Distance</strong><br />@UiHelpers.Km(ev.DistanceKm)</div>
                <div class="col-sm-6 mb-2"><strong>🧑‍💼 Organiser</strong><br />@ev.OrganiserName</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <h2 class="h4">About this event</h2>
                <p style="white-space: pre-line">@ev.Description</p>
            }
        </div>

        <div class="panel mt-4">
            <h2 class="h4">Categories</h2>
            @if (categories.Count == 0)
            {
                <p class="text-muted mb-0">The organiser hasn't added any categories yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-raceday">
                        <thead><tr><th>Category</th><th>Ages</th><th>Distance</th></tr></thead>
                        <tbody>
                            @foreach (var c in categories)
                            {
                                <tr>
                                    <td>@c.CategoryName</td>
                                    <td>@UiHelpers.AgeRange(c.MinAge, c.MaxAge)</td>
                                    <td>@(c.DistanceKm.HasValue ? UiHelpers.Km(c.DistanceKm.Value) : UiHelpers.Km(ev.DistanceKm))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <h2 class="h4">Enter this event</h2>

            @if (role == Roles.Participant)
            {
                if (Model.MyEnrolment != null)
                {
                    <p class="mb-2">You're entered in <strong>@Model.MyEnrolment.CategoryName</strong>.</p>
                    <p class="mb-3">Status: <partial name="_StatusBadge" model="Model.MyEnrolment.EnrolmentStatus" /></p>
                    <a asp-controller="Participant" asp-action="Enrolments" class="btn btn-outline-raceday w-100">View my enrolments</a>
                }
                else if (Model.HasPassed)
                {
                    <p class="text-muted mb-0">This event has already taken place, so entries are closed.</p>
                }
                else if (categories.Count == 0)
                {
                    <p class="text-muted mb-0">Entries open once the organiser adds categories.</p>
                }
                else
                {
                    <form asp-controller="Events" asp-action="Enrol" method="post">
                        <input type="hidden" name="eventId" value="@ev.EventId" />
                        <p class="text-muted">Choose your category:</p>
                        @foreach (var c in categories)
                        {
                            <div class="mb-2">
                                <input type="radio" class="btn-check" name="categoryId" id="cat-@c.CategoryId" value="@c.CategoryId" autocomplete="off" required />
                                <label class="category-option" for="cat-@c.CategoryId">
                                    <strong>@c.CategoryName</strong><br />
                                    <small class="text-muted">@UiHelpers.AgeRange(c.MinAge, c.MaxAge)</small>
                                </label>
                            </div>
                        }
                        <button type="submit" class="btn btn-raceday w-100 mt-2">Enter event</button>
                    </form>
                }
            }
            else if (role == Roles.Organiser)
            {
                if (Model.IsOwner)
                {
                    <p class="text-muted">You organise this event.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-raceday">Edit event</a>
                        <a asp-controller="Organiser" asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-raceday">Categories</a>
                        <a asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-raceday">Enrolments (@ev.EnrolmentCount)</a>
                        <a asp-controller="Organiser" asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-raceday">Results</a>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Only participants can enter events.</p>
                }
            }
            else
            {
                <p class="text-muted">Log in or create a free account to enter this event.</p>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-raceday w-100 mb-2">Log in to enter</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-raceday w-100">Create an account</a>
            }
        </div>
    </div>
</div>
