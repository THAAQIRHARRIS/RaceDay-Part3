@{
    ViewData["Title"] = "Page not found";
}
<div class="empty-state">
    <div class="big">🧭</div>
    <h1 class="h2">We couldn't find that page</h1>
    <p>The page or event you're looking for doesn't exist, or it may have been removed.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-raceday">Browse events</a>
</div>
