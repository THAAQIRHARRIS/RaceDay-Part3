@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="panel">
            <h1 class="mb-4">@(isEdit ? "Edit event" : "Create event")</h1>

            <form method="post" enctype="multipart/form-data" novalidate
                  asp-action="@(isEdit ? "EditEvent" : "CreateEvent")"
                  asp-route-id="@(isEdit ? Model.EventId : null)">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Pietermaritzburg, KwaZulu-Natal" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventTypeId" class="form-label"></label>
                        <select asp-for="EventTypeId" asp-items="EventFormViewModel.TypeOptions" class="form-select">
                            <option value="">Choose a type...</option>
                        </select>
                        <span asp-validation-for="EventTypeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="BannerFile" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ExistingBannerUrl" alt="Current banner" class="img-fluid rounded" style="max-height:160px" />
                            <div class="form-text">Current banner. Choose a new file to replace it.</div>
                        </div>
                    }
                    <input asp-for="BannerFile" type="file" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" />
                    <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-raceday">@(isEdit ? "Save changes" : "Create event")</button>
                    <a asp-action="Events" class="btn btn-outline-raceday">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
