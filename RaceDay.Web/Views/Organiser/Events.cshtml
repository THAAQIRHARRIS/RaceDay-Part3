@model List<EventDto>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-raceday">+ Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state panel">
        <div class="big">🏁</div>
        <h2 class="h4">No events yet</h2>
        <p>Create your first event to start taking entries.</p>
        <a asp-action="CreateEvent" class="btn btn-raceday">Create event</a>
    </div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-raceday table-hover">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Distance</th><th class="text-center">Entries</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.OrderByDescending(x => x.EventDate))
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold text-decoration-none">@e.Name</a></td>
                            <td>@UiHelpers.ShortDate(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td><span class="type-pill type-@e.EventType.ToLowerInvariant() mb-0">@e.EventType</span></td>
                            <td>@UiHelpers.Km(e.DistanceKm)</td>
                            <td class="text-center">@e.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-sm btn-raceday">Edit</a>
                                <a asp-action="Categories" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-raceday">Categories</a>
                                <a asp-action="Enrolments" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-raceday">Enrolments</a>
                                <a asp-action="Results" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-raceday">Results</a>
                                <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? Its categories, enrolments and results will be removed too.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
